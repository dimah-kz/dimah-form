{
  "name": "@dimah-form/scoring",
  "version": "0.6.1",
  "description": "Official scoring plugin for dimah-form (Likert and option keying)",
  "keywords": [
    "form",
    "questionnaire",
    "survey",
    "scoring",
    "likert",
    "keying",
    "subscale",
    "gad-7",
    "typescript"
  ],
  "homepage": "https://form.dimah.dev/docs/plugins/scoring",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-form/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-form.git",
    "directory": "packages/scoring"
  },
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --cache",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dimah-form/core": "workspace:*",
    "@dimah-form/server": "workspace:*",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dimah-form/core": "workspace:^",
    "@dimah-form/server": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@dimah-form/server": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
