{
  "name": "@dimah-form/server",
  "version": "0.0.0",
  "description": "Questionnaire server — dimahForm() with HTTP handler and direct api",
  "keywords": [
    "form",
    "questionnaire",
    "survey",
    "better-call",
    "nextjs",
    "typescript"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-form.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/dimah-kz/dimah-form",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-form/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "default": "./dist/adapters/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-form/core": "workspace:*",
    "better-call": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "^1.9.5",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
