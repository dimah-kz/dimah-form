{
  "name": "@dimah-form/core",
  "version": "0.0.0",
  "description": "Typed questionnaire protocol and fetch client shared by @dimah-form/server and @dimah-form/react",
  "keywords": [
    "form",
    "questionnaire",
    "survey",
    "protocol",
    "typescript"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-form.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/dimah-kz/dimah-form",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-form/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-fetch/fetch": "catalog:",
    "better-call": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "^1.9.5",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
