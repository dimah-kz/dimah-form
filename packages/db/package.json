{
  "name": "@dimah-form/db",
  "version": "0.0.1",
  "description": "FumaDB adapter for dimah-form — questionnaires and responses",
  "keywords": [
    "form",
    "questionnaire",
    "survey",
    "fumadb",
    "drizzle",
    "drizzle-orm",
    "prisma",
    "typescript"
  ],
  "author": "Hamidrezakz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-form.git",
    "directory": "packages/db"
  },
  "homepage": "https://github.com/dimah-kz/dimah-form",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-form/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-form/core": "workspace:*",
    "fumadb": "catalog:"
  },
  "peerDependencies": {
    "@dimah-form/server": "workspace:*"
  },
  "devDependencies": {
    "@dimah-form/server": "workspace:*",
    "@types/node": "^26.5.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "tsc-alias": "^1.9.5",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
