{
  "name": "@dimah-form/db",
  "version": "0.6.1",
  "description": "FumaDB adapter for dimah-form — questionnaires and responses",
  "keywords": [
    "form",
    "questionnaire",
    "survey",
    "fumadb",
    "drizzle",
    "drizzle-orm",
    "prisma",
    "kysely",
    "typescript"
  ],
  "homepage": "https://form.dimah.dev/docs/persistence",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-form/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-form.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src/schema/examples"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --cache",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-form/core": "workspace:*",
    "fumadb": "catalog:"
  },
  "devDependencies": {
    "@dimah-form/server": "workspace:*",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dimah-form/server": "workspace:^",
    "drizzle-orm": "^0.44.0 || ^0.45.0 || >=1.0.0-rc.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
