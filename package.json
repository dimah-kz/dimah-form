{
  "name": "dimah-form",
  "private": true,
  "homepage": "https://github.com/dimah-kz/dimah-form",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-form/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimah-kz/dimah-form.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "prettier --write --cache --cache-location .prettiercache .",
    "format:check": "prettier --check --cache --cache-location .prettiercache .",
    "knip": "knip",
    "lint": "eslint --max-warnings 0 --cache --cache-location .eslintcache --no-error-on-unmatched-pattern -- scripts prettier.config.mjs eslint.config.js vitest.config.ts knip.config.ts package.json pnpm-workspace.yaml && turbo run lint",
    "prepare": "lefthook install",
    "sherif": "sherif -r non-existant-packages",
    "tegami": "node ./scripts/tegami.mts",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "sherif": "catalog:",
    "tegami": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  }
}
